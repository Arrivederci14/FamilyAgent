# FamilyAgent 环境变量模板
# 用法：复制为 .env 后填入真实值（.env 已加入 .gitignore，不会被提交）
#     cp .env.example .env
# 变量名不区分大小写；未在此列出的项都有默认值，见 familyagent/config.py

# ===== 必填：阿里云百炼（大模型 + 嵌入模型共用同一个 Key）=====
# 控制台：https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ===== 必填：阿里云 DashVector（健康知识库向量存储）=====
# 控制台：https://dashvector.console.aliyun.com/
# 注意：集群白名单要放通你的出口 IP（或设为 0.0.0.0），否则检索会报 whiteList validate fail
DASHVECTOR_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DASHVECTOR_ENDPOINT=vrs-cn-xxxxxxxx.dashvector.cn-hangzhou.aliyuncs.com
DASHVECTOR_COLLECTION=familyagent

# ===== 大模型参数 =====
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=2048

# ===== 嵌入模型参数（维度必须与 DashVector 集合一致，换模型需重建集合）=====
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSION=1024

# ===== 可选：和风天气（家庭旅游规划 Agent 用）=====
# 控制台：https://console.qweather.com/
# 两项都留空表示未启用，此时 get_weather 工具会返回明确的「未配置」提示，不会报错
WEATHER_API_KEY=
# 账号专属 API Host，形如 xxxxxx.re.qweatherapi.com，见控制台「项目」页
WEATHER_API_HOST=

# ===== 服务参数 =====
APP_NAME=FamilyAgent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
LOG_LEVEL=info

# ===== 本地数据目录（相对项目根目录，实际落在 familyagent/ 下）=====
# history 存对话历史、familydata 存家庭档案，两者都已加入 .gitignore，只留在本机
HISTORY_DIR=history
FAMILY_DIR=familydata

# ===== 健康知识库 / RAG 参数 =====
DATA_DIR=data
KNOWLEDGE_FILE=health_knowledge.csv
UPLOAD_DIR=uploads
CHUNK_SIZE=200
CHUNK_OVERLAP=30
# 检索返回条数
RETRIEVE_TOP_K=1
# 相关性下限（score 为距离，越小越相似，超过该值的检索结果会被丢弃）
# 实测相关问题 top1 在 0.26~0.34、无关问题在 0.69 以上，取 0.5 作分界；设为 1.0 表示不过滤
RETRIEVE_SCORE_THRESHOLD=0.5
